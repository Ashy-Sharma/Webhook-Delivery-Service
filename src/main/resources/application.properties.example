spring.application.name=Webhook-Delivery-Service

spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:webhook}
spring.datasource.username=${DB_USERNAME:webhooks_user}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.jpa.hibernate.ddl-auto=validate

# Generate a private Base64-encoded key with: openssl rand -base64 32
jwt.secret=${JWT_SECRET}
jwt.expiration-ms=900000
jwt.refresh-expiration-ms=604800000

server.port=${SERVER_PORT:8080}

spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USERNAME:guest}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:guest}
spring.rabbitmq.publisher-confirm-type=correlated
spring.rabbitmq.publisher-returns=true
spring.rabbitmq.template.mandatory=true

webhook.rabbitmq.exchange=webhook.exchange
webhook.rabbitmq.delivery-queue=webhook.deliveries
webhook.rabbitmq.delivery-routing-key=webhook.deliver
webhook.rabbitmq.dlq-queue=webhook.dlq
webhook.rabbitmq.poison-queue=webhook.poison
webhook.rabbitmq.poison-routing-key=webhook.poison
webhook.rabbitmq.publish-confirm-timeout-ms=5000

webhook.retry.max-attempts=5
webhook.retry.delays=2000,10000,30000
webhook.event-types=order.created,order.updated,user.signup,payment.failed
webhook.ratelimit.max-per-minute=30
webhook.ratelimit.window-ms=60000
webhook.ratelimit.max-throttle-age-ms=3600000
webhook.infrastructure.max-deferral-age-ms=300000

spring.rabbitmq.listener.simple.acknowledge-mode=manual
spring.rabbitmq.listener.simple.prefetch=1
spring.rabbitmq.listener.simple.default-requeue-rejected=false
spring.task.scheduling.pool.size=4

spring.data.redis.timeout=500ms
spring.data.redis.connect-timeout=500ms
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}

management.endpoints.web.exposure.include=health
